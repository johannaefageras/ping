{
  "name": "ping",
  "version": "1.0.0",
  "description": "A tiny web app for sharing texts, links, and files with a friend. No social media required.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Johanna Fagerås",
  "homepage": "https://github.com/johannaefageras/ping#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannaefageras/ping.git"
  },
  "bugs": {
    "url": "https://github.com/johannaefageras/ping/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test:e2e": "playwright install chromium && playwright test",
    "test:fixtures:seed": "node scripts/e2e-fixtures.ts seed",
    "test:fixtures:clean": "node scripts/e2e-fixtures.ts clean",
    "test:fixtures:check": "node scripts/e2e-fixtures.ts check",
    "test": "npm run test:unit -- --run && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@supabase/supabase-js": "^2.112.4",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "^4.1.8",
    "playwright": "^1.60.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  }
}
